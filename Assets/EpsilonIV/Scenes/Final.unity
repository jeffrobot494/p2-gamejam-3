  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::player2_sdk.NpcManager
  clientId: 019a0338-5b0f-7093-9475-601b58617a39
  TTS: 1
  keepGameState: 0
  functions:
  - name: come_down
    description: "Corporal Hale climbs down from the crane when he believes it is
      safe, or when he receives a direct order from Captain Markov to come down,
      let go, stand down, or return to base.  Use this function whenever Hale finally
      acts on that decision \u2014 breaking free from his flashback or obeying an
      order to descend. This represents the moment Hale physically climbs down from
      the crane and the encounter ends.  Triggers:  Hearing a command from Captain
      Markov to descend.  Realizing the \u201Cbattle\u201D isn\u2019t real.  Deciding
      on his own that it\u2019s safe to climb down."
    functionArguments: []
    neverRespondWithMessage: 0
  functionHandler:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 7282535529447092767}
        m_TargetAssemblyTypeName: EpsilonIV.DanglingNpcFunctionHandler, Assembly-CSharp
        m_MethodName: HandleFunctionCall
        m_Mode: 0
